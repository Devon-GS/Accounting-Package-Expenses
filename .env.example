DB_PASSWORD=replace_with_a_long_random_password
REPLICATION_PASSWORD=replace_with_a_long_random_password
DB_PORT_BINDING=5432
APP_NAME=name_of_company
DOCKER_NAME=name_for_docker_image_and_container

# Authentication for the single administrator account.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=generate_this_locally_with_the_command_in_the_README_or_deployment_notes
# python -c "from getpass import getpass; from werkzeug.security import generate_password_hash; print(generate_password_hash(getpass()))"
SESSION_SECRET=generate_a_long_random_secret_for_production
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set this to true in HTTPS production deployments. It defaults to false for local HTTP development.
# SESSION_COOKIE_SECURE=true
# Set FLASK_ENV=production, or set SESSION_COOKIE_SECURE=true explicitly, for HTTPS production.
FLASK_ENV=development
# Increment this value to invalidate all existing authenticated sessions.
SESSION_VERSION=1
# Defaults to 8 hours.
# SESSION_LIFETIME_HOURS=8
